<Rive version="1" kind="fragment">
    <!--
        One lesson node on the chapter path.

        The app owns every decision: which of the four states the node is in,
        how far the wedge has filled, whether a finger is on it, and when the
        finished moment fires. This file only decides how each of those looks
        and moves. The contract is the LessonNode view model at the bottom;
        docs/mobile/lesson-node-rive.md explains it.

        Geometry: a 100pt face, a 10pt plinth below it (the painter had 7; a
        button wants more edge), 12pt of air around both so the finished pop
        and its halo have room. The face's top-left corner is at (12, 12).
    -->
    <Artboard defaultStateMachineId="0:70" viewModelId="0:100" viewModelInstanceId="0:101"
              width="124" height="134" styleId="0:3" name="LessonNode" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:3"/>

        <!-- Everything that moves when pressed. The plinth stays put. -->
        <Node x="62" y="62" name="Press" id="0:20">

            <!-- Everything that pops when the lesson is finished. -->
            <Node x="0" y="0" name="Pop" id="0:24">

                <!-- The finished check. -->
                <Shape x="0" y="0" opacity="0" name="Check" id="0:46">
                    <PointsPath isClosed="false" name="Path">
                        <StraightVertex x="-15.6" y="0.9"/>
                        <StraightVertex x="-5.5" y="11"/>
                        <StraightVertex x="15.6" y="-8.2"/>
                    </PointsPath>
                    <Stroke thickness="4.6" cap="round" join="round" name="Stroke">
                        <SolidColor colorValue="FFFFF9F0" name="Ink" id="0:47">
                            <DataBindContext sourcePathIds="0:100-0:110" propertyKey="37"/>
                        </SolidColor>
                    </Stroke>
                </Shape>

                <!-- The "not written yet" ellipsis. -->
                <Shape x="0" y="0" opacity="0" name="Dots" id="0:48">
                    <Ellipse x="-6.1" y="0" width="4.1" height="4.1" name="L"/>
                    <Ellipse x="0" y="0" width="4.1" height="4.1" name="M"/>
                    <Ellipse x="6.1" y="0" width="4.1" height="4.1" name="R"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFA79B87" name="Ink" id="0:49">
                            <DataBindContext sourcePathIds="0:100-0:110" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                </Shape>

                <!--
                    The progress wedge: a thick stroke on a small circle, trimmed
                    from the top. Thickness equals the circle's diameter, so the
                    trimmed stroke reads as a filled pie slice, not an arc.
                    Radius 47.25 matches the painter: the face radius less the rim
                    and a hair of inset.
                -->
                <Node x="0" y="0" opacity="0" name="WedgeGroup" id="0:38">
                    <Shape x="0" y="0" name="Wedge" id="0:40">
                        <DataBindContext sourcePathIds="0:100-0:103" propertyKey="18" converterId="0:131"/>
                        <Ellipse width="47.25" height="47.25" name="Path" id="0:41"/>
                        <Stroke thickness="47.25" cap="butt" name="Stroke" id="0:42">
                            <SolidColor colorValue="FFE8683A" name="Wedge" id="0:43">
                                <DataBindContext sourcePathIds="0:100-0:109" propertyKey="37"/>
                            </SolidColor>
                            <TrimPath start="0" end="0.15" name="Sweep" id="0:44">
                                <DataBindContext sourcePathIds="0:100-0:103" propertyKey="115" converterId="0:130"/>
                            </TrimPath>
                        </Stroke>
                    </Shape>
                </Node>

                <!-- The rim, on the two unfinished circle states. -->
                <Shape x="0" y="0" opacity="1" name="Rim" id="0:34">
                    <Rectangle width="97.3" height="97.3" cornerRadiusTL="48.65" name="Path" id="0:35"/>
                    <Stroke thickness="2.7" name="Stroke">
                        <SolidColor colorValue="FF2C2C2C" name="Rim" id="0:36">
                            <DataBindContext sourcePathIds="0:100-0:108" propertyKey="37"/>
                        </SolidColor>
                    </Stroke>
                </Shape>

                <!-- The face. Circle or rounded square, decided by the state. -->
                <Shape x="0" y="0" name="Face" id="0:30">
                    <Rectangle width="100" height="100" cornerRadiusTL="50" name="Path" id="0:31"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFFFFFFF" name="Face" id="0:32">
                            <DataBindContext sourcePathIds="0:100-0:106" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                    <!-- Light from above: a touch of white along the top edge. -->
                    <Fill name="Top light">
                        <LinearGradient startX="0" startY="-50" endX="0" endY="10" name="Light">
                            <GradientStop colorValue="40FFFFFF" position="0"/>
                            <GradientStop colorValue="00FFFFFF" position="1"/>
                        </LinearGradient>
                    </Fill>
                    <!-- And a little shade gathering at the bottom, above the plinth. -->
                    <Fill name="Bottom shade">
                        <LinearGradient startX="0" startY="10" endX="0" endY="50" name="Shade">
                            <GradientStop colorValue="002C2C2C" position="0"/>
                            <GradientStop colorValue="1E2C2C2C" position="1"/>
                        </LinearGradient>
                    </Fill>
                </Shape>
            </Node>

            <!-- The halo that leaves the face at the finished moment. Invisible at rest. -->
            <Shape x="0" y="0" opacity="0" name="Halo" id="0:22">
                <Ellipse width="100" height="100" name="Path" id="0:23"/>
                <Stroke thickness="3" name="Stroke">
                    <SolidColor colorValue="FF2D7A5F" name="Halo" id="0:25">
                        <DataBindContext sourcePathIds="0:100-0:111" propertyKey="37"/>
                    </SolidColor>
                </Stroke>
            </Shape>
        </Node>

        <!-- The plinth: the face's own outline, 10pt lower, in a tone of the face. -->
        <Shape x="62" y="72" name="Plinth" id="0:12">
            <Rectangle width="100" height="100" cornerRadiusTL="50" name="Path" id="0:13"/>
            <Fill name="Fill">
                <SolidColor colorValue="FFC2BAAD" name="Plinth" id="0:14">
                    <DataBindContext sourcePathIds="0:100-0:107" propertyKey="37"/>
