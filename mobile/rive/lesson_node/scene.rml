<Rive version="1" kind="fragment">
    <!--
        One lesson node on the chapter path, drawn as an isometric platform
        (mobile/design/road/ROAD.md, owner 2026-11-03). Generated: the
        numbers below come from road.mjs and road.dart, so edit those first.

        The app owns every decision: which of the four states the node is in,
        how far the arc has filled, whether a finger is on it, whether the
        walked road has reached it yet, and when the finished moment and the
        arrival fire. This file only decides how each of those looks and
        moves. The contract is the LessonNode view model at the bottom;
        docs/mobile/lesson-node-rive.md explains it.

        Geometry, in units where the face is 100 across: the face is the
        node circle squashed to half height (K = 0.5), 100 by 50, centred at
        (62, 39). It stands on a plinth `depth` tall (default 100/6, so a
        84 pt node has the phone's 14 pt plinth); the foot is the face's
        ellipse moved straight down by the depth. Everything on the face is
        drawn in a node squashed to half height, so the ring and the check
        are foreshortened the way the face is.

        Nesting, outermost first: Ahead (the 95% rest and the rise) > Arrive
        (the bounce) > Breath (the current lesson) > the platform. All three
        scale about the middle of the side, 8.3333 below the face centre.
        First child draws on top.
    -->
    <Artboard defaultStateMachineId="0:70" viewModelId="0:100" viewModelInstanceId="0:101"
              width="124" height="100" styleId="0:3" name="LessonNode" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:3"/>

        <Node x="62" y="47.3333" name="Ahead" id="0:15">
            <Node x="0" y="0" name="Arrive" id="0:16">
                <Node x="0" y="0" name="Breath" id="0:17">
                    <!-- The platform, with its origin on the face centre. -->
                    <Node x="0" y="-8.3333" name="Platform" id="0:18">

                        <!-- Everything that sinks when pressed: the face and the top of the side. -->
                        <Node x="0" y="0" name="Press" id="0:20">

                            <!-- The halo that leaves the face at the finished moment, on the face's plane. -->
                            <Node x="0" y="0" scaleY="0.5" name="HaloTilt" id="0:27">
                                <Shape x="0" y="0" opacity="0" name="Halo" id="0:22">
                                    <Ellipse width="100" height="100" name="Path" id="0:23"/>
                                    <Stroke thickness="3" name="Stroke">
                                        <SolidColor colorValue="FF63F0A8" name="Halo" id="0:25">
                                            <DataBindContext sourcePathIds="0:100-0:111" propertyKey="37"/>
                                        </SolidColor>
                                    </Stroke>
                                </Shape>
                            </Node>

                            <!-- Everything that pops when the lesson is finished. -->
                            <Node x="0" y="0" name="Pop" id="0:24">
                                <!-- The face's plane: the circle squashed to half height. -->
                                <Node x="0" y="0" scaleY="0.5" name="Tilt" id="0:26">

                                    <!-- The finished check, road.mjs's path at this face's size. -->
                                    <Shape x="0" y="0" opacity="0" name="Check" id="0:46">
                                        <PointsPath isClosed="false" name="Path">
                                            <StraightVertex x="-17.8571" y="1.1905"/>
                                            <StraightVertex x="-7.1429" y="11.9048"/>
                                            <StraightVertex x="16.6667" y="-11.9048"/>
                                        </PointsPath>
                                        <Stroke thickness="7.7381" cap="round" join="round" name="Stroke">
                                            <SolidColor colorValue="FF63F0A8" name="Ink" id="0:47">
                                                <DataBindContext sourcePathIds="0:100-0:110" propertyKey="37"/>
                                            </SolidColor>
                                        </Stroke>
                                    </Shape>

                                    <!-- The "not written yet" ellipsis. -->
                                    <Shape x="0" y="0" opacity="0" name="Dots" id="0:48">
                                        <Ellipse x="-6.1" y="0" width="4.1" height="4.1" name="L"/>
                                        <Ellipse x="0" y="0" width="4.1" height="4.1" name="M"/>
                                        <Ellipse x="6.1" y="0" width="4.1" height="4.1" name="R"/>
                                        <Fill name="Fill">
                                            <SolidColor colorValue="FFA79B87" name="Ink" id="0:49">
                                                <DataBindContext sourcePathIds="0:100-0:110" propertyKey="37"/>
                                            </SolidColor>
                                        </Fill>
                                    </Shape>

                                    <!--
                                        The progress arc: 11 thick on a 89 circle, so its
                                        outer edge is the face's edge, trimmed from the top
                                        and drawn over the track below it. Butt ends, as in
                                        the approved R02.
                                    -->
                                    <Node x="0" y="0" opacity="0" name="WedgeGroup" id="0:38">
                                        <Shape x="0" y="0" name="Wedge" id="0:40">
                                            <DataBindContext sourcePathIds="0:100-0:103" propertyKey="18" converterId="0:131"/>
                                            <Ellipse width="89" height="89" name="Path" id="0:41"/>
                                            <Stroke thickness="11" cap="butt" name="Stroke" id="0:42">
                                                <SolidColor colorValue="FF2C2C2C" name="Wedge" id="0:43">
                                                    <DataBindContext sourcePathIds="0:100-0:109" propertyKey="37"/>
                                                </SolidColor>
                                                <TrimPath start="0" end="0.15" name="Sweep" id="0:44">
                                                    <DataBindContext sourcePathIds="0:100-0:103" propertyKey="115" converterId="0:130"/>
                                                </TrimPath>
                                            </Stroke>
                                        </Shape>
                                    </Node>

                                    <!-- The spring track under the arc, shown while a lesson is underway. -->
                                    <Shape x="0" y="0" opacity="0" name="Rim" id="0:34">
                                        <Rectangle width="89" height="89" cornerRadiusTL="44.5" name="Path" id="0:35"/>
                                        <Stroke thickness="11" name="Stroke">
                                            <SolidColor colorValue="FF63F0A8" name="Rim" id="0:36">
                                                <DataBindContext sourcePathIds="0:100-0:108" propertyKey="37"/>
                                            </SolidColor>
                                        </Stroke>
                                    </Shape>

                                    <!-- The face. Circle or rounded square, decided by the state. -->
                                    <Shape x="0" y="0" name="Face" id="0:30">
                                        <Rectangle width="100" height="100" cornerRadiusTL="50" name="Path" id="0:31"/>
                                        <Fill name="Fill">
                                            <SolidColor colorValue="FFFFF9F0" name="Face" id="0:32">
                                                <DataBindContext sourcePathIds="0:100-0:106" propertyKey="37"/>
                                            </SolidColor>
                                        </Fill>
                                    </Shape>
                                </Node>
                            </Node>

                            <!-- The top 8 of the side, which goes down with the face. -->
                            <Shape x="0" y="0" name="SideTop" id="0:50">
                                <Rectangle width="100" height="8" originY="0" name="Path" id="0:51"/>
                                <Fill name="Fill">
                        <SolidColor colorValue="FFCDBFA8" name="Plinth">
                            <DataBindContext sourcePathIds="0:100-0:107" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                            </Shape>
                        </Node>

                        <!-- The rest of the side, 8 down to the foot, and the foot: the face's outline `depth` lower. -->
                        <Shape x="0" y="8" name="SideBottom" id="0:54">
                            <Rectangle width="100" height="8.6667" originY="0" name="Path" id="0:55">
                                <DataBindContext sourcePathIds="0:100-0:115" propertyKey="21" converterId="0:132"/>
                            </Rectangle>
                            <Fill name="Fill">
                        <SolidColor colorValue="FFCDBFA8" name="Plinth">
                            <DataBindContext sourcePathIds="0:100-0:107" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                        </Shape>
                        <Node x="0" y="16.6667" name="Foot" id="0:52">
                            <DataBindContext sourcePathIds="0:100-0:115" propertyKey="14"/>
                            <Node x="0" y="0" scaleY="0.5" name="FootTilt" id="0:56">
                                <Shape x="0" y="0" name="FootShape" id="0:57">
                                    <Rectangle width="100" height="100" cornerRadiusTL="50" name="Path" id="0:58"/>
                                    <Fill name="Fill">
                        <SolidColor colorValue="FFCDBFA8" name="Plinth">
                            <DataBindContext sourcePathIds="0:100-0:107" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                                </Shape>
                            </Node>
                        </Node>
                    </Node>
                </Node>
            </Node>
        </Node>

