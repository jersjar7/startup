                    <GradientStop colorValue="002C2C2C" position="0"/>
                    <GradientStop colorValue="262C2C2C" position="1"/>
                </LinearGradient>
            </Fill>
        </Shape>

        <!-- A soft warm shadow under the plinth, in place of the painter's box shadow. -->
        <Shape x="62" y="86" name="Shadow" id="0:10">
            <Ellipse width="104" height="34" name="Path"/>
            <Fill name="Fill">
                <RadialGradient startX="0" startY="0" endX="52" endY="0" name="Soft">
